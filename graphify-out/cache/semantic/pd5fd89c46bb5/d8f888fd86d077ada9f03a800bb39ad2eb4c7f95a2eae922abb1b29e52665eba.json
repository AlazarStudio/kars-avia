{"nodes": [{"id": "docs_fap_doc", "label": "FAP.md \u2014 backend documentation", "file_type": "document", "source_file": "docs/FAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fap_passengerrequest", "label": "PassengerRequest (embedded Mongo document)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041e\u0434\u0438\u043d MongoDB-\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442: \u0432\u0441\u0435 \u0443\u0441\u043b\u0443\u0433\u0438 \u2014 embedded composite-\u0442\u0438\u043f\u044b (Prisma type, \u043d\u0435 model); \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0439 \u043d\u0435\u0442 (db push) \u2014 \u0441\u0445\u0435\u043c\u0443 \u043c\u0435\u043d\u044f\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0430\u0434\u0434\u0438\u0442\u0438\u0432\u043d\u043e; flightDate \u0443 \u0441\u0442\u0430\u0440\u044b\u0445 \u0437\u0430\u044f\u0432\u043e\u043a unset, \u043d\u0435 null."}, {"id": "docs_fap_savedpassengers", "label": "savedPassengers (passenger identity registry)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0438 (fullName, personCategory, phone, personType, seat), \u043c\u0430\u0442\u0447-\u043a\u043b\u044e\u0447 \u2014 personId; \u0440\u0443\u0447\u043d\u043e\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u0443\u0441\u043b\u0443\u0433\u0443 = \u0441\u0432\u0435\u0436\u0438\u0439 personId = \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a."}, {"id": "docs_fap_hydratepassengerrequest", "label": "hydratePassengerRequest (identity hydration)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0427\u0442\u0435\u043d\u0438\u0435 \u043d\u0430\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0440\u0435\u0435\u0441\u0442\u0440 \u043d\u0430 \u043b\u044e\u0434\u0435\u0439 \u0432\u0441\u0435\u0445 \u0443\u0441\u043b\u0443\u0433; \u0437\u0430\u043f\u0438\u0441\u044c \u043f\u0440\u043e\u043f\u0430\u0433\u0438\u0440\u0443\u0435\u0442 services \u2192 \u0440\u0435\u0435\u0441\u0442\u0440 (incoming-wins); \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u2014 \u0441\u043d\u0430\u043f\u0448\u043e\u0442 \u0432 \u0440\u0435\u0435\u0441\u0442\u0440 (existing-wins \u0434\u043b\u044f personCategory); \u0432\u044b\u0441\u0435\u043b\u0435\u043d\u0438\u044f \u0438 \u043e\u0442\u0447\u0451\u0442\u044b \u2014 \u0441\u043d\u0430\u043f\u0448\u043e\u0442\u044b, \u0433\u0438\u0434\u0440\u0430\u0446\u0438\u0435\u0439 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u044e\u0442\u0441\u044f."}, {"id": "docs_fap_recomputeservicestatus", "label": "recomputeServiceStatus (service status rules)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0427\u0438\u0441\u0442\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f, ~21 \u0432\u044b\u0437\u043e\u0432: CANCELLED \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0435\u043c; COMPLETED + \u043d\u043e\u0432\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2192 IN_PROGRESS; \u0444\u0430\u043a\u0442 \u2265 \u043f\u043b\u0430\u043d \u2192 COMPLETED (\u0430\u0432\u0442\u043e\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435)."}, {"id": "docs_fap_withfapauthguard", "label": "withFapAuthGuard (auth whitelist)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0417\u0430\u043a\u0440\u044b\u0442\u044b\u0439 \u0431\u0435\u043b\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u043e\u0432 (USER, EXTERNAL_USER, DRIVER, AIRLINE_PERSONAL) \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u00ab\u0441\u0443\u0431\u044a\u0435\u043a\u0442 \u043d\u0435\u043f\u0443\u0441\u0442\u00bb \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0430 \u0431\u044b \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0439 HOTEL_PREVIEW. \u0420\u0430\u0437\u043b\u0438\u0447\u0438\u0435 401/403 \u043d\u0435\u0441\u0443\u0449\u0435\u0435: \u0444\u0440\u043e\u043d\u0442\u043e\u0432\u044b\u0439 authErrorLink \u0441\u0447\u0438\u0442\u0430\u0435\u0442 UNAUTHENTICATED \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043c\u044b\u043c \u0438 \u0443\u0432\u043e\u0434\u0438\u0442 \u043d\u0430 \u043b\u043e\u0433\u0438\u043d."}, {"id": "docs_fap_fap_scope", "label": "FAP_SCOPE (cross-org request isolation)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f (\u043b\u043e\u0433 FAP_SCOPE \u0432 logs/warn/); \u0436\u0451\u0441\u0442\u043a\u0438\u0439 \u0440\u0435\u0436\u0438\u043c \u2014 env FAP_SCOPE_ENFORCE=true; \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0447\u043d\u044b\u0435 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u044b \u0438\u0437\u043e\u043b\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0431\u0435\u0437 \u0444\u043b\u0430\u0433\u0430; \u0447\u0443\u0436\u0430\u044f \u0437\u0430\u044f\u0432\u043a\u0430 \u043f\u043e id \u2192 null, \u043d\u0435 FORBIDDEN \u2014 \u0438\u043d\u0430\u0447\u0435 \u043a\u043e\u0434 \u043e\u0448\u0438\u0431\u043a\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435."}, {"id": "docs_fap_resolvescope", "label": "resolveScope (per-subject scoping rules)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fap_hotelreport", "label": "PassengerRequestHotelReport (reportRows)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041a\u043b\u044e\u0447 passengerRequestId + hotelIndex (@@unique); \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u2014 \u043f\u043e\u043b\u043d\u0430\u044f \u0437\u0430\u043c\u0435\u043d\u0430 \u0441\u0442\u0440\u043e\u043a \u0447\u0435\u0440\u0435\u0437 upsert; \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043d\u0435 \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u0431\u044d\u043a\u0435 \u2014 reportRows \u043f\u0438\u0448\u0435\u0442\u0441\u044f verbatim \u0441 \u0444\u0440\u043e\u043d\u0442\u0430."}, {"id": "docs_fap_ghost_rows", "label": "Ghost rows (tariff serialization in reportRows)", "file_type": "rationale", "source_file": "docs/FAP.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0422\u0430\u0440\u0438\u0444 \u2014 \u043d\u0435 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044c \u0431\u044d\u043a\u0430: \u0444\u0440\u043e\u043d\u0442 \u0441\u0435\u0440\u0438\u0430\u043b\u0438\u0437\u0443\u0435\u0442 \u0442\u0430\u0440\u0438\u0444\u044b \u0441\u0442\u0440\u043e\u043a\u0430\u043c\u0438 \u0441 \u043f\u0443\u0441\u0442\u044b\u043c fullName (tariffName = \u0438\u043c\u044f, roomKind: PER_ROOM \u2014 \u043c\u0430\u0440\u043a\u0435\u0440 \u0440\u0435\u0436\u0438\u043c\u0430 \u00ab\u041d\u043e\u043c\u0435\u0440\u00bb) \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435. Ghost-\u0441\u0442\u0440\u043e\u043a\u0438 \u043e\u0431\u044f\u0437\u0430\u043d\u044b \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f \u0438\u0437 \u043b\u044e\u0431\u044b\u0445 \u0441\u0443\u043c\u043c \u043f\u043e \u043b\u044e\u0434\u044f\u043c \u2014 \u0438\u043d\u0430\u0447\u0435 \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0441\u0447\u0451\u0442."}, {"id": "docs_fap_index_addressing", "label": "Index-addressed embedded arrays (hotelIndex/driverIndex/personIndex)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041f\u043e\u0440\u043e\u0436\u0434\u0430\u0435\u0442 ~45 \u043e\u0434\u043d\u043e\u0442\u0438\u043f\u043d\u044b\u0445 \u043c\u0443\u0442\u0430\u0446\u0438\u0439-\u043f\u0430\u0442\u0447\u0435\u0439; \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 relations \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043e \u043d\u0435\u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u043d\u043e \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u043c (\u0430\u0443\u0434\u0438\u0442 2026-07-21); \u044d\u0442\u0430\u043f\u044b 4\u20136 (55 \u2192 42 \u043c\u0443\u0442\u0430\u0446\u0438\u0438, \u0430\u0434\u0440\u0435\u0441\u0430\u0446\u0438\u044f \u043f\u043e id) \u0441\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u044b, \u043d\u0435 \u043d\u0430\u0447\u0430\u0442\u044b; \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0438\u043d\u0434\u0435\u043a\u0441\u044b \u0441\u043e\u0441\u0435\u0434\u0435\u0439."}, {"id": "docs_fap_recognizepassengerdocument", "label": "recognizePassengerDocument (photo OCR of documents)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yandex OCR \u2192 GPT, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f PWA; \u043f\u043e\u0434 rate-limit 40/\u043c\u0438\u043d \u043d\u0430 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u0430 \u2014 \u043a\u0430\u0436\u0434\u044b\u0439 \u0432\u044b\u0437\u043e\u0432 \u044d\u0442\u043e \u0434\u0432\u0430 \u043f\u043b\u0430\u0442\u043d\u044b\u0445 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0432 Yandex Cloud."}, {"id": "docs_fap_characterization_tests", "label": "Characterization test net (300+ tests)", "file_type": "concept", "source_file": "docs/FAP.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0424\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0432\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0430 prisma-\u0432\u044b\u0437\u043e\u0432\u043e\u0432; \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0440\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0430 \u2014 \u0442\u0435\u0441\u0442\u044b \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0431\u0435\u0437 \u0435\u0434\u0438\u043d\u043e\u0439 \u043f\u0440\u0430\u0432\u043a\u0438; \u043f\u0440\u0438 \u043f\u043e\u0447\u0438\u043d\u043a\u0435 \u0434\u0435\u0444\u0435\u043a\u0442\u0430 \u043e\u0431\u044f\u0437\u0430\u043d \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u0440\u043e\u0432\u043d\u043e \u043e\u0434\u0438\u043d \u0442\u0435\u0441\u0442, \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u044f\u0432\u044