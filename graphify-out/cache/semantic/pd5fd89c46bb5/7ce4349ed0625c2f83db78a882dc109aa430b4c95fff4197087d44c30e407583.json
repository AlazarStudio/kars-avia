heckFapScopeReadiness.js \u043d\u0430 \u0431\u043e\u044e + \u043b\u043e\u0433 \u0437\u0430 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u0446\u0438\u043a\u043b."}, {"id": "docs_fap_decisions_report_visibility", "label": "Decision: report opens to airline only on submit", "file_type": "rationale", "source_file": "docs/FAP-DECISIONS.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0414\u0438\u0441\u043f\u0435\u0442\u0447\u0435\u0440 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0438 \u0446\u0438\u0444\u0440; \u00ab\u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0430 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u0438\u044f\u00bb \u043e\u0442\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u043e \u044f\u0432\u043d\u043e; \u0444\u043b\u0430\u0433 \u043f\u043e \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0446\u0435, \u043d\u0435 \u043f\u043e \u0437\u0430\u044f\u0432\u043a\u0435; XLSX \u043f\u0440\u044f\u0447\u0435\u0442\u0441\u044f \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u044d\u043a\u0440\u0430\u043d\u043e\u043c \u2014 \u0438\u043d\u0430\u0447\u0435 \u0433\u0435\u0439\u0442 \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u044b\u0433\u0440\u0443\u0437\u043a\u043e\u0439; \u0442\u043e\u0447\u0435\u043a \u0443\u0442\u0435\u0447\u043a\u0438 \u0431\u044b\u043b\u043e \u0448\u0435\u0441\u0442\u044c, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0439 \u0430\u0433\u0440\u0435\u0433\u0430\u0442 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0438; \u043c\u043e\u0434\u0435\u043b\u044c \u00ab\u043e\u0442\u0447\u0451\u0442 \u0436\u0438\u0432\u043e\u0439, \u043d\u0435 \u0441\u043d\u0438\u043c\u043e\u043a\u00bb \u2014 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u0430 \u0433\u0430\u0441\u0438\u0442 \u043e\u0442\u043c\u0435\u0442\u043a\u0443."}, {"id": "docs_fap_decisions_pinning", "label": "Decision: pin figures only in submitted reports", "file_type": "rationale", "source_file": "docs/FAP-DECISIONS.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u0441\u044f \u0432\u043e\u043b\u0430\u0442\u0438\u043b\u044c\u043d\u0430\u044f \u044d\u043a\u0441\u043f\u043e\u0437\u0438\u0446\u0438\u044f (54 \u043a\u043e\u043c\u043d\u0430\u0442\u044b) \u0441\u0438\u0434\u0435\u043b\u0430 \u0432 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043e\u0442\u0447\u0451\u0442\u0430\u0445; \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0439 \u043f\u0438\u043d\u043d\u0438\u043d\u0433 \u043e\u0442\u0432\u0435\u0440\u0433\u043d\u0443\u0442 \u2014 \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0431\u044b \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0442\u044c \u0441\u043d\u0438\u043c\u043e\u043a \u0432 \u0432\u043e\u0441\u044c\u043c\u0438 \u043c\u0435\u0441\u0442\u0430\u0445. \u0412\u0438\u0434 \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u043d\u043e\u043c\u0435\u0440\u0443, \u043d\u0435 \u0433\u043e\u0441\u0442\u044e (\u043f\u0435\u0440\u0432\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0440\u0430\u0437\u043e\u0448\u043b\u0430\u0441\u044c \u0448\u0430\u043f\u043a\u043e\u0439 \u0441 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438); savedPricePerDay \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u0442\u0430\u0440\u0438\u0444\u0430; \u043f\u043e\u0440\u043e\u0433 > 0 \u043d\u0435\u0441\u0443\u0449\u0438\u0439 \u2014 \u043d\u043e\u043b\u044c \u0437\u043d\u0430\u0447\u0438\u0442 \u00ab\u043d\u0435\u0447\u0435\u043c \u043f\u0438\u043d\u043d\u0438\u0442\u044c\u00bb, \u0430 \u043d\u0435 \u00ab\u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u00bb."}, {"id": "docs_fap_decisions_days_rules", "label": "Decision: FAP days rules (duration, manual override, evictions)", "file_type": "rationale", "source_file": "docs/FAP-DECISIONS.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u0443\u0442\u043a\u0438 \u043f\u043e \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 (\u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430 29.07), \u0441\u043a\u043e\u0443\u043f \u0442\u043e\u043b\u044c\u043a\u043e \u0424\u0410\u041f; \u0440\u0430\u0437\u0432\u043e\u0440\u043e\u0442 05.08 \u2014 \u0440\u0443\u0447\u043d\u0430\u044f \u043f\u0440\u0430\u0432\u043a\u0430 \u00ab\u0421\u0443\u0442.\u00bb \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f (\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u043e\u0442\u0447\u0451\u0442 \u0441\u0442\u0430\u043b \u0441\u043d\u0438\u043c\u043a\u043e\u043c \u043f\u043e \u0441\u0443\u0442\u043a\u0430\u043c); \u0434\u0432\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0441\u043b\u0438\u0442\u044b \u0432 fapPersonDays.js; \u0432\u044b\u0441\u0435\u043b\u0435\u043d\u043d\u044b\u0439 \u0432\u044b\u0431\u044b\u0432\u0430\u0435\u0442 \u0438\u0437 \u0441\u0447\u0451\u0442\u0430 \u0441\u043e\u0432\u0441\u0435\u043c; \u00ab\u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0439 \u0431\u0430\u0433 getPersonDays\u00bb \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0441\u044f \u2014 0 \u0438\u0437 744 \u0433\u043e\u0441\u0442\u0435\u0439."}, {"id": "docs_fap_decisions_billing_mode", "label": "Decision: billing mode belongs to tariff (PER_BED/PER_ROOM)", "file_type": "rationale", "source_file": "docs/FAP-DECISIONS.md", "source_location": "\u00a73.4", "so